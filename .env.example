# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Postgres (asyncpg driver). Tests use TEST_DATABASE_URL (a separate database that is wiped).
DATABASE_URL=postgresql+asyncpg://kulmax:kulmax@localhost:5432/kulmax
TEST_DATABASE_URL=postgresql+asyncpg://kulmax:kulmax@localhost:5432/kulmax_test

# JWT. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# JSON list of allowed browser origins (the Next.js app)
CORS_ORIGINS=["http://localhost:3000"]

BUSINESS_TIMEZONE=Africa/Kigali

# Used by `python tasks.py seed-admin` when --password is not given
SEED_ADMIN_PASSWORD=
